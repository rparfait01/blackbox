#!/bin/sh
# BLACK BOX commit gate. A change is not pushable unless the ENTIRE suite is green —
# not a subset, not "the part I touched". This is the tripwire so a fixed bug (the
# closure gate first among them) can never silently regress.
#
# ORDER IS DELIBERATE, cheapest and most local first:
#
#   1. corrections parser (Brief 34 §7.4) — pure file reads, no network, milliseconds.
#      A brief from 035 forward that omits its CORRECTIONS block, or writes a delta
#      instead of the full current reading, is rejected here. §1.2: silence is never
#      implicit.
#   2. pnpm gate = verify (typecheck + lint + unit tests + build) + acceptance
#      (the standing suite against the DEPLOYED app, incl. the closure gate).
#
# Step 1 runs first because step 2 costs REAL REQUESTS against the Workers plan limit,
# and the alert path goes down when that limit is reached. A governance defect must not
# be discovered only after spending ~1,500 requests to find it.
#
# The acceptance suite's coordinator checks need MAGIC_LINK_SECRET — set it in env or
# workers/api/test/.acceptance.env (gitignored). Activate this hook once with:
#   pnpm setup-hooks
# Bypass ONLY in a genuine emergency with `git push --no-verify`, then fix forward.
set -e
echo "[gate] checking brief corrections blocks (Brief 34 §1)…"
node scripts/supersession-index.mjs --check
echo "[gate] running: pnpm gate (verify + acceptance) before push…"
pnpm gate
echo "[gate] green — push allowed."
