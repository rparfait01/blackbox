# Local Worker secrets template. Copy to `.dev.vars` (gitignored) if you need to
# override anything for local `wrangler dev`. v0 has NO required secrets — the
# per-event HMAC secret is generated server-side and stored in D1.
#
# CORS origins are set in wrangler.toml [vars]; override here only if needed:
# CORS_ALLOWED_ORIGINS = "http://localhost:5173"
