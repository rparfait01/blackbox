# Activation-hold duration, in milliseconds — how long the breathing circle
# must be held for the covert activation trigger to fire.
# Production default is 5000 (5s); dev server defaults to 1500 (1.5s) for
# easier testing. Set this to override either default explicitly.
# VITE_REVEAL_HOLD_MS=5000

# Backend Worker base URL — LOCAL DEVELOPMENT ONLY (Brief 35 §B).
#
# Production and staging do NOT read this file. Their origin comes from the tracked
# config/deploy-targets.json, which the deploy pipeline validates and passes into the
# build environment — so a stale value here can never decide what production points at.
#
# In a DEV session this may be left unset: uploads stay off, capture stays local.
# In a PRODUCTION build a missing, empty, non-HTTPS or non-routable value FAILS THE
# BUILD (non-zero exit, nothing published). It is not a fallback and not a warning —
# a production build with no API origin has no alert path at all, and used to ship
# silently: active-looking alert, no event, no notification, no upload.
#
# For local dev with the Worker running:
# VITE_API_BASE_URL=http://localhost:8787
